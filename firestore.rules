rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      allow read: if isMember();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 50;
      allow update: if isMember() && (
        request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.epochs == resource.data.epochs
        || resource.data.members[request.auth.uid].role == "admin"
      );

      match /messages/{messageId} {
        function inChat() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }
        allow read, update, delete: if inChat();
        allow create: if inChat()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() < 100000;
      }

      match /typing/{uid} {
        function inChat() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }
        allow read: if inChat();
        allow write: if inChat() && request.auth.uid == uid;
      }
    }

    match /statuses/{uid}/items/{itemId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewers"])
      );
    }

    match /calls/{callId} {
      function party(data) {
        return signedIn() && (request.auth.uid == data.callerId || request.auth.uid == data.calleeId);
      }
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid;
      allow read, update: if party(resource.data);

      match /ice/{iceId} {
        function parent() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        allow read: if party(parent());
        allow create: if party(parent()) && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
