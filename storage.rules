rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function inChat(chatId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds;
    }

    match /media/{chatId}/{fileId} {
      allow read, write: if inChat(chatId);
    }

    match /profiles/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /status/{uid}/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
